# Square (Catalog + Checkout). Get these from the Square Developer Dashboard.
# https://developer.squareup.com/apps
# Until these are set, the site falls back to placeholder vehicle data (see src/lib/square/mock-vehicles.ts).
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# "sandbox" or "production"
SQUARE_ENVIRONMENT=sandbox

# Used to build the checkout redirect URL. Set to the deployed site URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (the staff CRM at /admin). Local dev: run `npx supabase start` in the
# repo root and copy API_URL / PUBLISHABLE_KEY / SECRET_KEY from `npx supabase status`.
# Production: Supabase Dashboard -> Project Settings -> API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses row-level security; never expose it to the browser.
SUPABASE_SECRET_KEY=
